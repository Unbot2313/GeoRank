# Copy to .env and fill in the values. Never commit .env.

# --- Django ---
# Generate with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Gemini ---
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Email ---
# Default backend prints emails to the terminal. For real delivery use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GeoRank <noreply@georank.local>

# --- App ---
# Base URL used to build links in emails
SITE_URL=http://127.0.0.1:8000
